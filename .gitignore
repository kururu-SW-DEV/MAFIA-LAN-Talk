# ── 비밀/개인 데이터 (절대 커밋 금지) ──────────────────────────
secret.key
*.key
.env
.env.*
# 실행 시 생기는 사용자 데이터: 설정(AI API 키 포함), 대화 로그, 아바타, 임시 전송분
data/
backup/
testdata/
firewall_notice_done

# ── 빌드 산출물 ──────────────────────────────────────────────
build/
dist/
*.exe
*.pyz
# PyInstaller가 자동 생성하는 spec만 무시하고, 직접 관리하는 빌드 설정은 추적한다
*.spec
!MAFIA.spec

# ── Python 캐시/도구 ─────────────────────────────────────────
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.mypy_cache/
*.egg-info/
.venv/
venv/

# ── 테스트 실행 중 생기는 임시 폴더/결과물 ─────────────────────
tests/tmp/
tests/tmp_*/
tests/smoke/
scratch/*.png

# ── 백업/임시 파일 ──────────────────────────────────────────
*.bak
*.bak_*
*.tmp
*.log
*.orig
*.rej

# ── 에디터/OS ───────────────────────────────────────────────
.vscode/
.idea/
.claude/
Thumbs.db
desktop.ini
.DS_Store

# ── 로컬 테스트용 모의 LLM 서버(저장소에 올리지 않음) ──
fakeserver/
